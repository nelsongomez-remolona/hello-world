\engtitle{.. bRihatpArAsharahorAshAstram 91-97 ..}##
\itxtitle{.. bR^ihatpArAsharahorAshAstram 91\-97 ..}##\endtitles ##

\section{atha grahaNajAtashAntyadhyAyaH || 91||}
sUryendugrahaNe kAle yeShAM janma bhaved dvija |
vyAdhiH kaShTaM cha dAridryaM teShAM mR^ityubhayaM bhavet || 1||
ataH shAntiM pravaxyAmi janAnAM hitakA~N.hxayA |
sUryasyendoshcha graheNaM yasminR^ixe prajAyate || 2||
tannaxatrapate rUpaM suvarNena prakalpayet |
sUryagrahe sUryarUpaM suvarNena svashaktitaH || 3||
chandragrahe chandrarUpaM rajatena tathaiva cha |
rAhurUpaM prakurvIta sIsakena vichaxaNaH || 4||
shuchau deshe samaM sthAnaM gomayena pralepayet |
tatra cha sthApayed vastraM nUtanaM sumanoharam || 5||
trayANAmeva rUpANAM sthApanaM tatra kArayet |
sUryagrahe pradAtavyaM sUryaprItikaraM cha yat || 6||
raktAxataM raktagandhaM raktamAlyAmbarAdikam |
chandragrahe pradAtavyaM chandraprItikaraM cha yat || 7||
shvetagandhaM shvetapuShpaM shvetamAlyAmbarAdikam |
rAhave cha pradAtavyaM kR^iShNapuShpAmbarAdikam || 8||
dadyAnnaxatranAthAya shvetagandhAdikaM tathA |
sUryaM sampUjayeddhImAnAkR^iShNeti cha mantrataH || 9||
athA chandraM ime devA iti mantreNa bhaktitaH |
dUrvAbhi pUjayedrAhuM kayA na iti mantrataH || 10||
sUryendvorarkapAlAshamid.hbhirjuhuyAt kramAt |
tathA cha rAhoH prItyarthaM dUrvAbhirdvijasattama || 11||
brahmavR^ixasamid.hbhishcha bheshAya juhuyAt punaH |
abhiShekaM tataH kuryAt jAtasya kalahodakaiH || 12||
AchAryaM pUjayed.hbhaktyA sushAnto vijitendriyaH |
brAhmaNAn bhojayetvA tu yathAshakti visarjayet || 13||
evaM grahaNajAtasya shAntiM kR^itvA vidhAnataH |
sarvavighnaM vinirjitvA saubhAgyaM labhate naraH || 14||
\section{atha gaNDAntajAtashAntyadhyAyaH || 92||}
tithinaxatralagnAnAM gaNDAntaM trividhaM smR^itam |
janmayAtrAvivAhAdau bhavettannidhanapradam || 1||
pUrNAnandAkhyayostithyoH sandhau nADIchatuShTayam |
adha UrdhvaM cha maitreya tithigaNDAntamuchyate || 2||
revatIdAsrayoH sApramaghayoH shAkramUlayoH |
sandhau naxatragaNDAntamevaM nADIchatuShTayam || 3||
mInAjayoH karkiharyorlagnayoralichApayoH |
sandhau cha lagnagaNDAntamadhaurdhva ghaTImitam || 4||
eShu chAbhuktamUlAkhyaM mahAvighnapadaM smR^itam |
indrarAxasayoH sandhau pa~nchAShTaghaTikAH kramAt || 5||
atha gaNDAntajAtasya shishoH shAntividhiM bruve |
gaNDAntakAlajAtasya sUtakAntyadine pitA || 6||
shAntiMshubhe.ahni vA kuryAt pashyet tAvanna taM shishum |
vR^iShabhaM tithigaNDAnte naxatre dhanumeva cha || 7||
kA~nchanaM lagnagaNDAnte dadyAttaddoShaprashAntaye |
AdyabhAge prajAtasya pitushchApyabhiShechanam || 8||
dvitIye tu shishormAturabhiShekaM cha kArayet |
suvarNena tadardheNa yathAvittaM dvijottama |
tithibheShAdirUpaM cha kR^itvA vastrasamanvitam || 9||
upachArairyathAshakti kalahopari pUjayet |
pUjAnte samidannajyairhoma. kuryAdyathAvidhi || 10||
brAhmaNAn bhojayet pashchAdevaM doShAtpramuchyate |
AyurArogyamaishvaryaM samprApnoti dine dine || 11||
\section{atha abhuktamUlashAntyadhyAyaH || 93||}
jyeShThAmUlamayoryasmAdadhipAvindrarAxasau |
mahAvairAt tayoH sandhirmahAdoShapradaH smR^itaH || 1||
abhuktamUlajaM putraM putrIM vA.api parityajet |
athavA.abdAShTakaM tAtastanmukhaM na vilokayet || 2||
taddoShaparihArArthamatha shAntividhiM bruve |
tatrA.adau doShabahulyAn mUlashAntirnigadyate || 3||
janmato dvAdashAhe vA tadR^ixe vA shubhe dine |
jAtasya vA.aShTame varShe shAntiM kuryAd vidhAnataH || 4||
susame cha shubhe sthAne gomayenopalepite |
maNDapaM svagR^ihAt prAchyAmudIchyAM vA prakalpayet || 5||
chaturdvArasamAyuktaM toraNAdyairala~N.hkR^itam |
kuNDaM grahAdiyaj~nArthaM tad.hbahishcha prakalpayet || 6||
suvarNena tadardhena tadardhArdhena vA punaH |
naxatradevatArUpaM kuryAd vittAnusArataH || 7||
shyAmavarNaM mahograM cha dvishiraskaM vR^ikAnanam |
khaD.hgacharmadharaM tadvad dhyeyaM kuNapavAhanam || 8||
suvarNasya cha mUlyaM vA sthApayitvA prapUjayet |
suvarNaM sarvadaivatyaM yataH shAstreShu nishchitam || 9||
AchAryaM varayet pashchAt svastivAchanupUrvakam |
kalashasthApanaM kuryAt svagR^ihyoktavidhAnataH || 10||
pa~nchagavyAdikaM xepyaM kalashe tIrthavAri cha |
shatauShadhyAdikaM tatra shatachChidraghaTe xipet || 11||
vaMshapAtraM cha saMsthApya tatra vai pashchimAmukham |
archeyennirR^itiM devaM shuklavastrAxatAdibhiH || 12||
indraM tadadhidevaM cha jalaM pratyadhidaivatam |
svasvashAkhoktamantreNa pradhAnAdIn.hprapUjayet || 13||
devAdhidevaprItyarthaM homaM kuryAdyathAvidhi |
aShTottaraM sahasraM vA shataM vA niyatendriyaH || 14||
mR^ityuprashamanArthaM cha mantraM tryambakaM japet |
prArthayechcha tato devamabhiShekArthamAdarAt || 15||
bhadrAsanopaviShTasya sastrIputrasya mantravit |
AchAryo yajamAnasya kuryAt prItyAbhiShechanam || 16||
vastrAntaritakumbhAbhyAM snApayettadanantaram |
shuklAmbaradharastadvat shvetagandhAnulepanaH || 17||
dhenuM payasvinIM dadyAdAchAryAya cha shaktitaH |
R^itvig.hbhyo daxiNAM dadyAd brAhmaNAMshchApi bhojayet || 18||
yatpApaM yachcha me dauHsthyaM sarvagAtreShvavasthitam |
tatsarvaM bhaxayAjya tvaM laxmIM puShTiM cha vardhaya || 19||
anenaiva tu mantreNa samyagAjyaM vilokayet |
mUlagaNDod.hbhavastaivaM sarpapApaM praNashyati || 20||
\section{atha jyeShThAdi gaNDashAntyadhyAyaH || 94||}
jyeShThAgaNDAntajAtastu pituH svasya cha nAshakaH |
tasya shAntividhiM vaxye sarvavighnopashAntaye || 1||
mUlashAntisamaM sarvamAtrApi maNDapAdikam |
indro.atra devatA tadvadadhidevo.analastathA || 2||
vij~neyaM cha tathA vipra raxaH pratyadhidaivatam |
yathAshakti suvarNena kuryAdindrasvarUpakam || 3||
vajrA~N.hkushadharaM divyaM gajarAjoparisthitam |
shAlitaNDulasaMyuktakumbhasyopari pUjayet || 4||
svasvagR^ihyoktamantreNa gandhapuShpAxatAdibhiH |
abhiShekaM cha homaM cha kuryAd brAhmaNabhojanam || 5||
indrasUktaM japed bhaktyA mantraM mR^ityu~njayaM tathA |
prArthayedindradevaM cha tataH shAntimavApnuyAt || 6||
atha vA shaktyabhAve tu kuryAd godAnameva hi |
yataH samastabhUdAnAd godAnamatirichyate || 7||
mUlendrAhimaghAgaNDajAte dadyAd gavAM trayam |
goyugmaM pauShNadAsrotthe gaNDAnte cha dvijanmane || 8||
anyagaNDe cha duryoge gAmekAM hi pradApayet |
gorabhAve cha viprAya dadyAt tanmUlyameva hi || 9||
jyeShThanaxatrajA kanyA vinihanti dhavAgrajam |
vishAkhAntyapadotpannA kanyA devaraghAtinI || 10||
tasyAH pradAnakAle.ato godAnamapi kArayet |
AshleShAntyatripAdotthau mUlAdyatripadod.hbhavau || 11||
kanyAsutau hataH shvashrUM shvashura~ncha yathAkramam |
tayorvivAhakAle.ataH shAntiM kuryAd vichaxaNaH || 12||
tattadoShavinAshAya yathAvittAnusArataH |
dhavAgrajadyabhAve tu na doShAya prajAyate || 13||
\section{atha trItarajanmashAntyadhyAyaH || 95||}
athA.anyat sampravaxyAmi janmadoShapradaM dvija |
sutatrye sutAjanma tat.htraye sutajanma chet || 1||
tadA.ariShTabhayaM j~neyaM pitR^imAtR^ikuladvaye |
tatra shAntividhiM kuryAd vittashAThyavivarjitaH || 2||
sUtakAnte.atha vA shuddhe samaye cha shubhe dine |
AchAryamR^itvijo vR^itvA grahayaj~napurassaram || 3||
brahmaviShNu maheshendrapratimAH svarNajAH shubhAH |
pUjayed dhAnyarAshisthakalashopari bhaktitaH || 4||
chatvAri rudrasUktAni shAntisUktAni sarvashaH |
vipra eko japed homakAle cha suchisaMyataH || 5||
AchAryo juhuyAttatra samidAjyatilAMshcharum |
aShTottaraM sahasraM vA shataM vA.aShTau cha viMshatim || 6||
brahmAdisarvadevebhyaH svasvagR^ihyoktamantrataH |
tataH sviShTakR^itaM hutvA baliM pUrNAhutiM punaH || 7||
abhiShekaM cha jAtasya sakuTumbasya kArayet |
R^itvig.hbhyo daxiNAM dadyAd brAhmaNAMshchApi bhojayet || 8||
kAMsyAjyavIxaNaM kR^itvA dInAnAthAMshcha tarpayet |
evaM shAntyA cha maitreya sarvAriShTaM vilIyate || 9||
\section{atha prasavavikArashAntyadhyAyaH || 96||}
athA.ahaM sampravaxyAmi vikAraM prasavod.hbhavam |
yenA.ariShTaM samastasya grAmasya cha kulasya cha || 1||
atyalpe vA.adhike kAle prasavo yadi jAyate |
hInA~NgovA.adhikA~Ngo vA vishirA dvishirAstathA || 2||
nAryA pashvAkR^itirvApi pashuShvapi narAkR^itiH |
prasavasya vikAro.ayaM vinAshAyopajAyate || 3||
yasya striyAH pashunAM vA vikArAH prasavod.hbhavaH |
aniShTaM bhavane tasya kule.api cha mahad bhavet || 4||
taddoShaparihArArthaM shAntiH kAryA prayatnataH |
strI vA gauvaMDavA vApi parityAjyA hitArthinA || 5||
nAryAH pa~nchadashe varShe janmataH ShoDasho.api vA |
garbho vA prasavo vA.api na shubhAya prajAyate || 6||
siMharAshisthite.arka gaunakrasthe mahiShI tathA |
prasUtA svAminaM hanti svayaM chApi vinashyati || 7||
brAhmaNAya pradadyAt tAM shAntiM vApi samAcharet |
brahmaviShNumaheshAnAM grahANAM chaiva pUjanam || 8||
sarvaM homAdikaM karma kuryAt tritarashAntivat |
tato gR^iho sukhI bhUtvA sarvapApaiH pramuchyate || 9||
evaM tvariShTe samprApte naraH shAntiM karoti yaH |
sarvAn kAmAnavApnoti chirajIvI sukhI cha saH || 10||
\section{athopasaMhArAdhyAyaH || 97||}
yachChAstraM brahmaNA proktaM nAradAya mahAtmane |
tadeva shaunakAdibhyo nAradaH prAha sAdaram || 1||
tato mayA yathA j~nAtaM tubhyamuktaM tathA dvija |
nAsUyakAya dAtavyaM paranindAratAya vA || 2||
jaDAya durvinItAya nAj~nAtAya kadAchana |
deyametatsurilAya bhaktAya satyavAdine || 3||
medhAvine vinItAya samyag j~nAtakulAya cha |
puNyadaM jyautiShaM shAstramagryaM vedA~Ngamuttamam || 4||
jAnAti kAlamAnaM yo graharxANAM cha saMsthitim |
horAshAstramidaM samyak sa vijAnAti nA.aparaH || 5||
horAshAstrArthatattvaj~naH satyavAg vijitendriyaH |
shubhA.ashubhaM phalaM vakti satyaM tadvachanaM bhavet || 6||
ye sushAstraM paThantIdaM ye vA shR^iNvanti bhaktitaH |
teShAMmAyurbalaM vittaM vR^iddhimeti yashaH sadA || 7||
itthaM parAshareNoktaM horAshAstraM chamatkR^itam |
navaM navajanaprItyai vividhAdhyAyasaMyutam || 8||
shreShThaM jagaddhitAyedaM maitreyAya dvijanmane |
tataH pracharitaM pR^ithvyAmAdR^itaM sAdaraM janaiH || 9||
granthe.asmin pR^ithagadhyAyairviShayA viniveshitAH |
sR^iShTikramo.avatArAshcha guNAH kheTasya bhasya cha || 10||
visheShalagnaM vargAshcha tadvivekashcha rAshidR^ik |
ariShTaM tadvibha~Ngashcha viveko bhAvajastathA || 11||
bhAvAnAM cha phalAdhyAyo bhAveshotthaphalaM tathA |
aprakAshaphalaM spaShTakheTadR^iShTiprasAdhanam || 12||
tataH spaShTabalAdhyAyaH iShTakaShTaprasAdhanam |
padaM chopapadaM tadvadargalA tvatha kArakAH || 13||
kArakAMshaphalaM yogakArakAdhyAya eva cha |
nAbhasA vividhA yogAshchandrayogo.arkayogakaH || 14||
rAjayogastataH prokto rAjasambandhayogakaH |
visheShadhanayogAshcha yogA dAridryakArakAH || 15||
AyurmArakabhedAshcha grahAvasthAH phalAnvitAH |
nAnAvidhadashAdhyAyAstatphalAdhyAyaH saMyutAH || 16||
antaHpratyantaraprANasUxmasaMj~nAshcha tad.hbhidAH |
sUryAdyaShTakavargashcha trikoNaparishodhanam || 17||
ekAdhipatyasaMshuddhistataH piNDaprasAdhanam |
tatashchA.aShTakavargANAM prasphuTAni phalAni cha || 18||
tato.apyaShTakavargAyuHsAdhanaM cha tataH param |
samudAyAShTavargotthaphalAdhyAyaH parisphuTaH || 19||
graharashmiphalAdhyAyaH sudarshanaphalaM tathA |
mahApuruShachihnAni mahAbhUtaphalAni cha || 20||
guNatrayaphalAdhyAyastato.apyaj~nAtajanmanAm |
janmalagnAdivij~nAnaM pravrajyAlaxaNAni cha || 21||
strINAM cha phalavaiShTyama~NgalaxmaphalAni cha |
pUrvapApotthashApotthayogA vaiputryakArakAH || 22||
satputraprAptyupAyAshcha sahaiva pratipAditAH |
janmanyaniShTalagnarxatithyAdipratipAdanam || 23||
tattachChAntividhishchaiva saMxepeNa pradarshitaH |
prasavasya vikArAshcha kathitAH shAntisaMyutAH || 24||
evaM jAtakavarye.atra niviShTA viShayAH shatam |
vij~nAya vibudhAstvetAn prApnuvantu yashaH shriyam || 25||
